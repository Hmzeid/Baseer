# Baseer runtime configuration
# mock = full pipeline with synthetic outputs (no key needed)
# live = real Meta Model API calls
BASEER_MODE=mock

# Meta Model API (verified 2026-10-21 — see backend/meta_client.py header):
#   base URL https://api.meta.ai/v1 (OpenAI-compatible)
#   key created at dev.meta.ai (API Keys tab), env name MODEL_API_KEY
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=

# STANDARD tier only. Never use "-contributor" variants: Meta may train on
# Contributor prompts/completions.
# Reasoning model plan: muse-spark-1.3 for development/testing loops;
# muse-wonder-1.0 (API top tier, $4/M in, $20/M out, Standard-only) for the
# FINAL report generation — decide by the pre-kickoff Arabic A/B test.
# NOTE: "Muse Wonder Full" is NOT an API model — it exists only inside
# Muse Code Power/Maximum subscriptions; no API credit can buy it.
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
