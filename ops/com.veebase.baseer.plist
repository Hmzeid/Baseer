<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Baseer production service (on-site Mac). Install:
     cp ops/com.veebase.baseer.plist ~/Library/LaunchAgents/
     # edit BASEER_ADMIN_PASSWORD below first (or remove it after first boot)
     launchctl load ~/Library/LaunchAgents/com.veebase.baseer.plist
     Logs: /Users/husseinabdelwahab/Ai/Baseer/data/baseer.log
     NEVER bind port 8000 here (Hussein's other app). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.veebase.baseer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/husseinabdelwahab/Ai/Baseer/.venv/bin/python</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>app:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8001</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/husseinabdelwahab/Ai/Baseer/backend</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BASEER_MODE</key><string>mock</string>
    <key>BASEER_ADMIN_PASSWORD</key><string>CHANGE-ME-ON-INSTALL</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/husseinabdelwahab/Ai/Baseer/data/baseer.log</string>
  <key>StandardErrorPath</key><string>/Users/husseinabdelwahab/Ai/Baseer/data/baseer.log</string>
</dict>
</plist>
